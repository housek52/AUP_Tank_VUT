<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="Mixing" Id="{c7d77201-326e-43f5-84be-5e5d3f37b70d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Mixing
VAR_INPUT
	diEnabled : BOOL;
	iSecImp : BOOL;
END_VAR
VAR_OUTPUT
	doEnabled : BOOL;
END_VAR
VAR_IN_OUT
	MixingPhase : TPhaseMixing;
	MixerEng : TEngine;
END_VAR
VAR
    rtSec : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[{region "Aut/Man"}
    // switching state of engine - automatic or manual control (default state is manual)
    // phase mode switch: a running phase is stopped when the mode changes
    IF MixingPhase.Cmd.AutCtrl AND NOT MixingPhase.State.AutCtrl THEN
        MixingPhase.State.AutCtrl := TRUE;
        MixingPhase.State.ManCtrl := FALSE;
        MixingPhase.State.Running := FALSE;
        MixingPhase.State.Paused  := FALSE;
        MixingPhase.State.Idle    := TRUE;
    ELSIF MixingPhase.Cmd.ManCtrl AND NOT MixingPhase.State.ManCtrl THEN
        MixingPhase.State.ManCtrl := TRUE;
        MixingPhase.State.AutCtrl := FALSE;
        MixingPhase.State.Running := FALSE;
        MixingPhase.State.Paused  := FALSE;
        MixingPhase.State.Idle    := TRUE;
    END_IF;
    MixingPhase.Cmd.AutCtrl := FALSE;
    MixingPhase.Cmd.ManCtrl := FALSE;

    // default mode is manual
    IF NOT MixingPhase.State.AutCtrl AND NOT MixingPhase.State.ManCtrl THEN
        MixingPhase.State.ManCtrl := TRUE;
    END_IF;
{endregion}

{region "ManCtrl"}
    // processing manual actions - if command is processed, it is sets to FALSE even if can't be processed
    MixingPhase.Cmd.StartMan  := FALSE;
    MixingPhase.Cmd.StopMan   := FALSE;
    MixingPhase.Cmd.PauseMan  := FALSE;
    MixingPhase.Cmd.ResumeMan := FALSE;
    // Phase commands are start, stop, pause and resume 

    // Start - start mixing
    IF MixingPhase.Cmd.StartMan AND MixingPhase.State.Idle AND NOT MixerEng.State.GenErr THEN
            MixingPhase.State.Idle     := FALSE;
            MixingPhase.State.Running  := TRUE;
            MixingPhase.State.Done     := FALSE;
            MixingPhase.ElapsedTimeSec := 0;
            MixerEng.Cmd.AutCtrl := TRUE;     // mixer must be in auto, the phase drives it by request
    END_IF;

    // Stop - stop mixing
    IF MixingPhase.Cmd.StopMan AND (MixingPhase.State.Running OR MixingPhase.State.Paused) THEN
            MixingPhase.State.Running := FALSE;
            MixingPhase.State.Paused  := FALSE;
            MixingPhase.State.Idle    := TRUE;
    END_IF;

    // Pause - stop mixing
    IF MixingPhase.Cmd.PauseMan AND MixingPhase.State.Running THEN
            MixingPhase.State.Running := FALSE;
            MixingPhase.State.Paused  := TRUE;
    END_IF;

    // Resume - start mixing
    IF MixingPhase.Cmd.ResumeMan AND MixingPhase.State.Paused AND NOT MixerEng.State.GenErr THEN
            MixingPhase.State.Paused  := FALSE;
            MixingPhase.State.Running := TRUE;
    END_IF;
    // real states of phase are writed into states in phase structure
   
{endregion}

{region "AutCtrl"}
    // if request to run in automatic mode -> set auto request to mixing to 1, if not request to mixing is 0
    IF MixingPhase.State.AutCtrl THEN
        IF MixingPhase.Cmd.StartAut AND MixingPhase.State.Idle AND NOT MixerEng.State.GenErr THEN
            MixingPhase.State.Idle     := FALSE;
            MixingPhase.State.Running  := TRUE;
            MixingPhase.State.Done     := FALSE;
            MixingPhase.ElapsedTimeSec := 0;
            MixerEng.Cmd.AutCtrl := TRUE;
        END_IF;

        IF MixingPhase.Cmd.StopAut AND (MixingPhase.State.Running OR MixingPhase.State.Paused) THEN
            MixingPhase.State.Running := FALSE;
            MixingPhase.State.Paused  := FALSE;
            MixingPhase.State.Idle    := TRUE;
        END_IF;
    END_IF;
    // commands should be sets to false after their processing
    MixingPhase.Cmd.StartAut := FALSE;
    MixingPhase.Cmd.StopAut  := FALSE;
{endregion}

{region "Done"}
    // every phase should have finish condition - mixing phase - if time of runnig is bigger or same as requested
    // after that done state should be setted to 1
    rtSec(CLK := iSecImp);
    IF MixingPhase.State.Running AND rtSec.Q THEN
        MixingPhase.ElapsedTimeSec := MixingPhase.ElapsedTimeSec + 1;
    END_IF;

    IF MixingPhase.State.Running AND (MixingPhase.ElapsedTimeSec >= MixingPhase.ParamTimeSec) THEN
        MixingPhase.State.Running := FALSE;
        MixingPhase.State.Idle    := TRUE;
        MixingPhase.State.Done    := TRUE;
    END_IF;

    IF MixingPhase.Cmd.ResetDone THEN
        MixingPhase.State.Done := FALSE;
        MixingPhase.Cmd.ResetDone := FALSE;
    END_IF;
{endregion}

{region "States"}
    //Command mixer in cases of states
    IF MixingPhase.State.Running AND MixerEng.State.GenErr THEN
        MixingPhase.State.Running := FALSE;
        MixingPhase.State.Paused  := TRUE;
    END_IF;
    
    MixerEng.Cmd.Req2RunAutCtrl := MixingPhase.State.Running;
{endregion}


// delault state of phase - if not any state sets state to idle
IF NOT MixingPhase.State.Idle AND NOT MixingPhase.State.Done AND NOT MixingPhase.State.Paused AND NOT MixingPhase.State.Running THEN
    MixingPhase.State.Idle := 1;
END_IF;


// delault state of phase - if not any state sets state to idle
IF MixingPhase.State.Idle THEN
    MixingPhase.State.StateInt := Global.PhIdle;
ELSIF MixingPhase.State.Running THEN
    MixingPhase.State.StateInt := Global.PhRunning;
ELSE
    MixingPhase.State.StateInt := Global.PhPause;
END_IF;

doEnabled := diEnabled;
]]></ST>
    </Implementation>
    <LineIds Name="Mixing">
      <LineId Id="10" Count="1" />
      <LineId Id="24" Count="10" />
      <LineId Id="78" Count="5" />
      <LineId Id="99" Count="1" />
      <LineId Id="103" Count="3" />
      <LineId Id="123" Count="4" />
      <LineId Id="132" Count="18" />
      <LineId Id="9" Count="0" />
      <LineId Id="166" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>