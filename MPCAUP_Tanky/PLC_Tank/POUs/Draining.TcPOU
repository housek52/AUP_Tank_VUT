      <LineId Id="97" Count="3" />
      <LineId Id="112" Count="4" />
      <LineId Id="123" Count="1" />
      <LineId Id="126" Count="0" />
      <LineId Id="154" Count="11" />
      <LineId Id="138" Count="0" />
      <LineId Id="153" Count="0" />
      <LineId Id="139" Count="0" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>