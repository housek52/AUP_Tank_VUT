@startuml
autonumber
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 13
skinparam sequenceMessageAlign center

skinparam sequence {
  ParticipantFontSize 13
  ArrowFontSize 12
  BoxFontSize 13
  GroupFontSize 12
  GroupBodyBackgroundColor transparent
  LifeLineBorderColor #888888
  participantPadding 3
  boxPadding 5
}
participant "Batch\nkontrolér" as BK

box "Moduly řízení (Fáze)" #F8F9FA
  participant "Napouštění" as FIL
  participant "Ohřev" as HEA
  participant "Míchání" as MIX
  participant "Vypouštění" as DRA
end box

box "Řídicí moduly (CM)" #F0F4F8
  participant "Plnicí\nventil" as VF
  participant "Vypouštěcí\nventil" as VD
  participant "Míchadlo" as MO
  participant "Topení\n(PID)" as TO
end box

BK -> BK: ověř start (Idle, GenErr=0)

alt podmínky OK
  note over BK, VF: 1. Napouštění
  BK -> FIL: StartAut (ParamFillLevel)
  FIL -> VF: Req2OpenAut=1
  VF --> FIL: OpenOut=1, Open=1
  
  loop WaterLevel < ParamFillLevel
    FIL -> FIL: čti WaterLevel
    opt porucha ventilu
      VF --> FIL: GenErr=1, OpenOut=0
      FIL --> BK: Held, alarm
      BK -> FIL: Restart (operátor)
    end
  end
  
  FIL -> VF: Req2CloseAut=1
  VF --> FIL: Closed=1
  FIL --> BK: Done
  BK -> FIL: ResetDone

  note over BK, TO: 2. Ohřev a míchání (paralelně)
  par ohřev
    BK -> HEA: StartAut (ParamReqTemp)
    HEA -> TO: Req2RunAutCtrl=1, SetPoint
    loop teplota 10 s v pásmu ±1 °C
      TO -> TO: PID výkon
      HEA -> HEA: čti WaterTemp
      opt WaterTemp > mez
        TO --> HEA: GenErr=1, vypnuto
        HEA --> BK: Held, alarm
      end
    end
    HEA --> BK: Done
  else míchání
    BK -> MIX: StartAut (ParamTimeSec)
    MIX -> MO: Req2RunAutCtrl=1
    loop čas < ParamTimeSec
      note over MIX, MO: míchadlo běží
      MIX -> MIX: iSecImp, ElapsedTimeSec+1
    end
    MIX --> BK: Done
  end

  BK -> HEA: ResetDone (vypnout)
  BK -> MIX: ResetDone (vypnout)

  note over BK, VD: 3. Vypouštění
  BK -> DRA: StartAut (ParamDrainLevel)
  DRA -> VD: Req2OpenAut=1
  VD --> DRA: Open=1
  loop WaterLevel > ParamDrainLevel
    note over DRA, VD: ventil otevřen
    DRA -> DRA: čti WaterLevel
  end
  DRA -> VD: Req2CloseAut=1
  VD --> DRA: Closed=1
  DRA --> BK: Done
  BK -> DRA: ResetDone
  BK -> BK: hotovo, zápis do protokolu

else podmínky NOK
  BK -> BK: start zamítnut, alarm
end
@enduml