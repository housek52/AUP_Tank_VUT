@startuml
left to right direction
skinparam shadowing false
skinparam roundcorner 10
skinparam usecase {
  BackgroundColor #F8F9FA
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

actor "Neregistrovaný uživatel" as Nereg
actor "Přihlášený uživatel\n(Operátor)" as Prihl
actor "Technolog" as Tech


Prihl --|> Nereg
Tech --|> Prihl

rectangle "SCADA vizualizace (MPCAUP_Tanky)" {
  usecase "UC1: Sledovat stav nádrže a alarmy" as UC1
  usecase "UC2: Přepnout režim\n(Cmd.ManCtrl / Cmd.AutCtrl)" as UC2
  usecase "UC3: Ovládat zařízení manuálně" as UC3
  usecase "UC4: Spustit a sledovat dávku\n(automatický režim)" as UC4
  usecase "UC5: Vybrat recepturu" as UC5
  usecase "UC6: Resetovat poruchu\n(Cmd.ResetSUF)" as UC6
  usecase "UC7: Konfigurovat systém a parametry\n(Param..., Time2Open, Time2Start)" as UC7
}

Nereg -- UC1
Prihl -- UC3
Prihl -- UC4
Prihl -- UC6
Tech -- UC7


UC3 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>
UC4 ..> UC5 : <<include>>
@enduml